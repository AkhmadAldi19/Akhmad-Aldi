---
const { dates, role, company, description } = Astro.props;
---

<div class="relative flex flex-col justify-start pl-12">
  <!-- Titik Checkpoint -->
  <div
    class="absolute top-1.5 left-0 z-40 w-3 h-3 -translate-x-1/2 rounded-full bg-neutral-400 dark:bg-neutral-600 ring-4 ring-white dark:ring-neutral-950"
  ></div>

  <p
    class="text-xs uppercase text-neutral-400 dark:text-neutral-500 tracking-widest"
  >
    {dates}
  </p>
  <h3 class="my-1 text-lg font-bold dark:text-neutral-100">{role}</h3>
  <p class="mb-1 text-sm font-medium dark:text-neutral-300">{company}</p>
  <p class="text-sm font-light text-neutral-600 dark:text-neutral-400">
    {description}
  </p>
</div>