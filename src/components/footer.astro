      >
    </a>

    <!-- LinkedIn -->
    <a
      href="https://www.linkedin.com/in/akhmad-aldi19/"
      target="_blank"
      class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
    >
      <span class="sr-only">LinkedIn</span>
      <svg
        class="w-6 h-6"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
        ><path
          d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
        /></svg
      >
    </a>

    <!-- Behance -->
    <a
      href="https://www.behance.net/aldiakhmad"
      target="_blank"
      class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
    >
      <span class="sr-only">Behance</span>
      <svg
        class="w-6 h-6"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
        ><path
          d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-4.726 3-3.214 0-5.333-2.298-5.333-5.526 0-3.15 2.072-5.474 5.381-5.474 2.875 0 4.319 1.954 4.636 3.426l.169.756h-8.082c.114 1.636 1.458 2.824 3.415 2.824 1.26 0 2.308-.492 2.748-1.296l.858.371zm-4.726-5.83c-1.398 0-2.213.916-2.392 2.114h4.74c-.097-1.198-.925-2.114-2.348-2.114zm-11.458 4.757c0 1.554-1.127 2.573-2.952 2.573-1.638 0-2.679-.882-2.796-2.247h-1.922c.196 2.42 2.13 3.924 4.718 3.924 2.88 0 4.872-1.758 4.872-4.596 0-4.088-4.582-4.186-4.858-6.108 0-.96.794-1.574 2.058-1.574 1.259 0 1.944.59 2.077 1.456h1.908c-.183-2.091-1.745-3.306-4.103-3.306-2.33 0-4.015 1.398-4.015 3.52 0 2.224 1.922 2.43 4.887 3.196zm-5.714-9.927h-4.996v-2h4.996v2Z"
        /></svg
      >
    </a>

  </span>
</div>
</section>
