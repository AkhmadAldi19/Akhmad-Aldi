---
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="About Me">
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="About Me"
      description="Hello 👋 I'm Aldi, a Brand Strategist, Logo Designer, and Social Media Officer."
    />

    <!-- Foto Pas Foto di Kiri -->
    <div class="flex justify-start my-8">
      <img src="/assets/images/about.jpg" class="relative z-30 w-36 h-48 object-cover rounded-xl shadow-lg" />
    </div>

    <!-- Pemisah / Divider dengan Tombol di Tengah -->
    <div class="relative my-14 flex items-center justify-center">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-dashed border-neutral-700"></div>
      </div>
      <a href="#skills" class="relative z-10 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-neutral-400 bg-neutral-950 border border-neutral-800 rounded-full hover:border-neutral-600 transition-colors">
        My Skills & Expertise ↓
      </a>
    </div>

    <!-- Bagian Skills -->
    <div id="skills" class="mb-12">
      <h2 class="mb-4 text-2xl font-bold dark:text-neutral-200">Skills & Tools</h2>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Brand Strategy</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Logo & Branding Design</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Social Media Officer</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">UI/UX Design</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Figma</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Adobe Photoshop</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Adobe Illustrator</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Android Studio</span>
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-800 text-neutral-200 rounded-lg">Kotlin</span>
      </div>
    </div>

    <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">Short Bio</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      I am an Informatics Engineering graduate from Universitas Yudharta Pasuruan, specializing in graphic design, mobile app development, and UI/UX design. I have extensive experience working on various design and development projects, both on-site and remotely. During my studies, I actively participated in community service programs such as PPK ORMAWA and KKNT, where I contributed to the creation of tourism logos, websites, and booking applications. I am highly proficient in design software including Adobe Photoshop, Illustrator, and Figma, and possess strong Android development skills using Kotlin and Android Studio. I am passionate about continuously learning and evolving in the fields of technology and design.
    </p>

    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      Education
    </h2>
    <div class="px-5 py-10">
      <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
        <AboutExperience
          dates="2007 - 2013"
          role="Elementary School"
          company="SDN Ledug 1"
          description="Formal Education"
        />
      </div>
      <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
        <AboutExperience
          dates="2013 - 2016"
          role="Junior High School"
          company="MTs NU Miftahul Huda Ledug"
          description="Formal Education"
        />
      </div>
      <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
        <AboutExperience
          dates="2016 - 2019"
          role="Multimedia"
          company="SMKN 1 Prigen"
          description="Formal Education"
        />
      </div>
      <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
        <AboutExperience
          dates="2020 - 2024"
          role="Bachelor of Informatics Engineering (GPA: 3.74)"
          company="Universitas Yudharta Pasuruan"
          description="Formal Education"
        />
      </div>
    </div>

    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      Experience
    </h2>
    <div class="px-5 py-10">
      {
        experiences.map((experience) => {
          return (
            <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
              <AboutExperience
                dates={experience.dates}
                role={experience.role}
                company={experience.company}
                description={experience.description}
                logo={experience.logo}
              />
            </div>
          )
        })
      }
    </div>

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200">Let's Connect</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      If you are interested in collaborating or have any questions, feel free to send me an <a href="mailto:aldiakhmad15@gmail.com" class="text-indigo-600 underline"
        >email</a
      > and I will be sure to get back to you.
    </p>
  </section>
</Layout>